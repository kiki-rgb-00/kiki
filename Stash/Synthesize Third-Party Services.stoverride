name: Synthesize Third-Party Services

icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/SSID.png

category: Private

desc: |-
  Synthesize Third-Party Services
  19 Service Availability Tests
  Detection Interval: 1 Hour
  Request Timeout: 10 Seconds


script-providers:

  Service-Availability-YouTube:
    interval: 86400


  Service-Availability-Netflix:
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/Stash/Customization/JS/Service-Availability.js

  Service-Availability-Disney:
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/Stash/Customization/JS/Service-Availability.js

  Service-Availability-Spotify:
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/Stash/Customization/JS/Service-Availability.js

  Service-Availability-TikTok:
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/Stash/Customization/JS/Service-Availability.js

  Service-Availability-Twitch:
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/Stash/Customization/JS/Service-Availability.js

  Service-Availability-ChatGPT:
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/Stash/Customization/JS/Service-Availability.js

  Service-Availability-Gemini:
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/Stash/Customization/JS/Service-Availability.js

  Service-Availability-Claude:
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/Stash/Customization/JS/Service-Availability.js




tiles:

  - name: Service-Availability-YouTube
    argument: 'YouTube'
    interval: 3600
    title: 'YouTube'
    content: '检测中'
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/YouTube.png
    collapsed: true

  - name: Service-Availability-Netflix
    argument: 'Netflix'
    interval: 3600
    title: 'Netflix'
    content: '检测中'
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Netflix.png
    collapsed: true

  - name: Service-Availability-Disney
    argument: 'Disney+'
    interval: 3600
    title: 'Disney+'
    content: '检测中'
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Disney+.png
    collapsed: true

  - name: Service-Availability-Spotify
    argument: 'Spotify'
    interval: 3600
    title: 'Spotify'
    content: '检测中'
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Spotify.png
    collapsed: true

  - name: Service-Availability-TikTok
    argument: 'TikTok'
    interval: 3600
    title: 'TikTok'
    content: '检测中'
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/TikTok.png
    collapsed: true

  - name: Service-Availability-Twitch
    argument: 'Twitch'
    interval: 3600
    title: 'Twitch'
    content: '检测中'
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Twitch.png
    collapsed: true

  - name: Service-Availability-GPT
    argument: 'GPT'
    interval: 3600
    title: 'GPT'
    content: '检测中'
    icon: https://fastly.jsdelivr.net/gh/shindgewongxj/WHATSINStash/icon/openai.png
    collapsed: true

  - name: Service-Availability-Gemini
    argument: 'Gemini'
    interval: 3600
    title: 'Gemini'
    content: '检测中'
    icon: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/google-gemini.png
