name: Stash-VPS
icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/GitHub.png
category: Private

desc: |-
  Version: 2.2｜2026-6.5
  TUN｜Fallback DNS｜Fake-iP
  DNS｜Proxy Groups｜Rules
  Encrypted DNS:
   - DoH｜IPv6｜IPv4
  Policy Groups:
   - PROXY-Gate:Primary/US/SG/HK/TW/JP/CA/UK
  Rules:
   - Rule-Providers：Domain
    （Some remote rule sets abandon IP rules）
   - Customize｜CN
   - MATCH -> PROXY-Gate (Default Fallback)

#!override

mixed-port: 7890
allow-lan: true
bind-address: '*'
mode: rule
log-level: info
external-controller: '127.0.0.1:9090'
unified-delay: true
tcp-concurrent: true
ipv6: true

tun: #!replace
  enable: true
  stack: gvisor
  auto-route: true
  auto-detect-interface: true
  strict-route: true
  dns-hijack:
    - any:53
    - tcp://any:53

dns: #!replace
  enable: true
  respect-rules: true
  ipv6: true
  prefer-h3: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16

  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
    - 2400:3200::1

  nameserver:
    # 🇺🇸 US｜Cloudflare
    - https://dns.cloudflare.com/dns-query
    # 🇪🇺 EU｜DNS4EU Unfiltered
    - https://unfiltered.joindns4.eu/dns-query

  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query

# 提前写入 #
  direct-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
# =========================================== #

  nameserver-policy:
    'dns.cloudflare.com':
      - 1.1.1.1
      - 1.0.0.1
    'dns.google':
      - 8.8.8.8
      - 8.8.4.4
    'dns.alidns.com':
      - 223.5.5.5
      - 223.6.6.6
    'doh.pub':
      - 1.12.12.12
      - 120.53.53.53
    # CN DNS #
    'geosite:cn':
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
    # Apple #
    '+.apple.com':
      - https://dns.alidns.com/dns-query
    '+.mzstatic.com':
      - https://dns.alidns.com/dns-query
    '+.itunes.apple.com':
      - https://dns.alidns.com/dns-query
    '+.aaplimg.com':
      - https://dns.alidns.com/dns-query

  fallback:
    # 🇺🇸 US｜Google
    - https://dns.google/dns-query

  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4
      - 127.0.0.0/8
      - 0.0.0.0/32

  fake-ip-filter:
    - 'geosite:cn'
    - '*.lan'
    - '*.local'
    - 'localhost'
    - '*.msftconnecttest.com'
    - '*.msftncsi.com'
    - '*.msidentity.com'
    - 'captive.apple.com'
    - '*.push.apple.com'
    - 'stun.*'
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'
    - 'speedtest.net'

profile: #!replace
  store-selected: true
  store-fake-ip: true

#-------------------#
# proxies: #
#-------------------#
proxy-groups: #!replace

  - name: PROXY-Gate
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png
    proxies:
      - 🔘 Primary-Manual
      - 🇺🇸 US-Auto
      - 🇸🇬 SG-Auto
      - 🇭🇰 HK-Auto
      - 🇹🇼 TW-Auto
      - 🇯🇵 JP-Auto
      - 🇨🇦 CA-Auto
      - 🇬🇧 UK-Auto
      - DIRECT

  # ====== Custom ====== #
  # ==================== #

  - name: 🔘 Primary-Manual
    type: select
    include-all: true
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Server.png



  # ======== Service Groups ======== #

  - name: Apple Push
    type: fallback
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple_2.png
    proxies:
      -  APNs-Fallback
      - DIRECT
    url: http://captive.apple.com/hotspot-detect.html
    interval: 600


  - name: YouTube
    type: select
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/YouTube.png
    proxies:
