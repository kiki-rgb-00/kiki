    include-all: true
    filter: '(?i)(\[HK\]|^HK$|Hong Kong|\bHK\b|香港|🇨🇳香港)'
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15
    tolerance: 50

  - name: 🇹🇼 TW-Auto
    type: url-test
    include-all: true
    filter: '(?i)(\[TW\]|^TW$|Taiwan|\bTW\b|台湾|台北|🇹🇼台湾)'
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15
    tolerance: 50

  - name: 🇯🇵 JP-Auto
    type: url-test
    include-all: true
    filter: '(?i)(\[JP\]|^JP$|Japan|\bJP\b|日本|东京|大阪|🇯🇵日本)'
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15
    tolerance: 50

  - name: 🇨🇦 CA-Auto
    type: url-test
    include-all: true
    filter: '(?i)(\[CA\]|^CA$|Canada|加拿大|Toronto|Vancouver|Montreal)'
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15
    tolerance: 50

  - name: 🇬🇧 UK-Auto
    type: url-test
    include-all: true
    filter: '(?i)(?!.*Ukraine)(\[UK\]|^UK$|United Kingdom|Britain|\bUK\b|英国|伦敦)'
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15
    tolerance: 50



rules: #!replace

  # GitHub
  - DOMAIN-SUFFIX,github.com,PROXY-Gate
  - DOMAIN-SUFFIX,githubusercontent.com,PROXY-Gate
  - DOMAIN-SUFFIX,githubassets.com,PROXY-Gate
  - DOMAIN-SUFFIX,raw.githubusercontent.com,PROXY-Gate

  # Local area network and e-mail
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - DST-PORT,465,DIRECT
  - DST-PORT,587,DIRECT
  - DST-PORT,993,DIRECT
  - DST-PORT,995,DIRECT
  - GEOIP,LAN,DIRECT,no-resolve

  # Remote rule set
  - RULE-SET,AdvertisingLite,REJECT
  - RULE-SET,AdvertisingLite_Domain,REJECT
  - RULE-SET,Privacy,REJECT
  - RULE-SET,Privacy_Domain,REJECT
  - RULE-SET,ACL4SSR_BanAD,REJECT
  - RULE-SET,ACL4SSR_BanProgramAD,REJECT

  #=========Custom rules=========#

  # Apple
  # (Basic connection and time)
  - DOMAIN,time.apple.com,DIRECT
  - DOMAIN,captive.apple.com,DIRECT

  # (Push service)
  - DOMAIN-SUFFIX,push.apple.com,Apple Push
  - DOMAIN-SUFFIX,push-apple.com.akadns.net,Apple Push
  - DOMAIN-SUFFIX,courier-push-apple.com.akadns.net,Apple Push
  #- DOMAIN-SUFFIX,akadns.net,Apple Push
  - DOMAIN-KEYWORD,apple.com.edgekey.net,Apple Push
  - DOMAIN-KEYWORD,push.apple,Apple Push
  - DOMAIN,feedback.push-apple.com.akadns.net,Apple Push
  - IP-CIDR,17.249.0.0/16,Apple Push,no-resolve
  - IP-CIDR,17.252.0.0/16,Apple Push,no-resolve
  - IP-CIDR,17.57.144.0/22,Apple Push,no-resolve
  - IP-CIDR,17.188.128.0/18,Apple Push,no-resolve
  - IP-CIDR,17.188.20.0/23,Apple Push,no-resolve
  - IP-CIDR6,2620:149:a44::/48,Apple Push,no-resolve
  - IP-CIDR6,2403:300:a42::/48,Apple Push,no-resolve
  - IP-CIDR6,2403:300:a51::/48,Apple Push,no-resolve
  - IP-CIDR6,2a01:b740:a42::/48,Apple Push,no-resolve

  # (iCloud)
  - DOMAIN-SUFFIX,icloud.com.cn,DIRECT
  - DOMAIN-SUFFIX,icloud.com,DIRECT
  - DOMAIN-SUFFIX,icloud-content.com,DIRECT
  - DOMAIN-SUFFIX,icloud.com.akadns.net,DIRECT
  - DOMAIN-SUFFIX,apple-cloudkit.com,DIRECT
  - DOMAIN,gateway.icloud.com,DIRECT

  # （Apple Music）
  - DOMAIN-SUFFIX,music.apple.com,DIRECT
  - DOMAIN-SUFFIX,api.music.apple.com,DIRECT
  - DOMAIN-SUFFIX,amp-api.music.apple.com,DIRECT
  - DOMAIN,aod.itunes.apple.com,DIRECT
  - DOMAIN,play.itunes.apple.com,DIRECT


  #策略组规则#
