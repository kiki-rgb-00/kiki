rule-providers: #!replace

  Microsoft:
    behavior: domain
    format: mrs
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/MRS/Microsoft.mrs

  Copilot_Domain:
    behavior: domain
    format: mrs
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/MRS/Copilot_Domain.mrs

  Copilot_IP:
    behavior: ipcidr
    format: mrs
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/MRS/Copilot_IP.mrs

  AdvertisingLite:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/Rules/AdvertisingLite.yaml

  AdvertisingLite_Domain:
    behavior: domain
    format: mrs
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/MRS/AdvertisingLite_Domain.mrs

  Privacy:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/Rules/Privacy.yaml

  Privacy_Domain:
    behavior: domain
    format: mrs
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/MRS/Privacy_Domain.mrs

  ACL4SSR_BanAD:
    behavior: domain
    format: mrs
    interval: 86400
    url: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/mrs/BanAD_domain.mrs

  ACL4SSR_BanProgramAD:
    behavior: domain
    format: mrs
    interval: 86400
    url: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/mrs/BanProgramAD_domain.mrs

  ACL4SSR_BanProgramAD_iP:
    behavior: ipcidr
    format: mrs
    interval: 86400
    url: https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/mrs/BanProgramAD_ip.mrs

  ChinaMax:
    behavior: classical
    format: yaml
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/Rules/ChinaMax.yaml

  ChinaMax_Domain:
    behavior: domain
    format: mrs
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/MRS/ChinaMax_Domain.mrs

  ChinaMax_IP:
    behavior: ipcidr
    format: mrs
    interval: 86400
    url: https://raw.githubusercontent.com/kiki-rgb-00/kiki/refs/heads/main/MRS/ChinaMax_IP.mrs
