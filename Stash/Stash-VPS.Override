  # ======== AUTO ======== #
  # ====================== #

  - name: 🇺🇸 US-Auto
    type: url-test
    include-all: true
    filter: '(?i)(\[US\]|^US$|USA|United States|\bUS\b|美国)'
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    url: http://www.gstatic.com/generate_204
    interval: 600
    timeout: 15
    tolerance: 50

  - name: 🇸🇬 SG-Auto
    type: url-test
    include-all: true
    filter: '(?i)(\[SG\]|^SG$|Singapore|\bSG\b|新加坡|狮城)'
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15
    tolerance: 50

  - name: 🇭🇰 HK-Auto
